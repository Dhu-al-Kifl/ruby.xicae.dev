{
  "name": "WebCode IDE",
  "short_name": "WebCode",
  "description": "In-Browser IDE & Universal Execution Engine",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#05070a",
  "theme_color": "#05070a",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=dev.xicae.webcode",
      "id": "dev.xicae.webcode"
    }
  ],
  "prefer_related_applications": true,
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/plain": [".py", ".js", ".cpp", ".html", ".sql", ".txt", ".md"]
      }
    }
  ]
}
